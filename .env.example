# -----------------------------------------------------------------------------
# Signal Terminal — environment configuration
# Copy to .env.local (local dev) or set in your host's secret manager.
# NEVER commit real values. Every secret below is read on the server only.
# Everything is optional: with no configuration the app runs with the
# embedded database and free official RSS feeds.
# -----------------------------------------------------------------------------

# --- Core -----------------------------------------------------------------
# Public URL of the app (used in alert links).
APP_URL=http://localhost:3000
LOG_LEVEL=info

# --- Database -------------------------------------------------------------
# Leave DATABASE_URL empty to use the embedded PostgreSQL (PGlite) at
# PGLITE_DATA_DIR. Set it for managed PostgreSQL (Neon, Supabase, RDS…).
DATABASE_URL=
PGLITE_DATA_DIR=.data/pglite
# Apply migrations + default seed on startup.
DB_AUTO_MIGRATE=true

# --- Worker ---------------------------------------------------------------
# inline   = background jobs run inside the web server (default; required with PGlite)
# separate = run `npm run worker` as its own process (requires DATABASE_URL)
# off      = no background processing
WORKER_MODE=inline

# --- Accounts -------------------------------------------------------------
# The first account created becomes the workspace owner. Further sign-ups
# are only allowed when this is true.
ALLOW_SIGNUP=false
SESSION_TTL_DAYS=30

# --- Demo mode ------------------------------------------------------------
# Replays a fictional, clearly labelled sample script through the real
# pipeline. Sample items are never sent to external notification channels.
DEMO_MODE=false
DEMO_INTERVAL_SECONDS=20

# --- Official RSS / Atom sources (free) -----------------------------------
RSS_ENABLED=true
RSS_POLL_SECONDS=300
RSS_USER_AGENT=SignalTerminal/0.1 (self-hosted market research tool)
RSS_CONTENT_RETENTION_DAYS=365
# SEC requires automated clients to declare who they are, e.g.
# "Your Name your.email@example.com". sec.gov feeds stay idle until set.
SEC_USER_AGENT=

# --- X API v2 (paid, pay-per-use) -----------------------------------------
# App-only Bearer token from https://console.x.com . Reads are billed per
# post/user returned; budgets below cap daily usage.
X_BEARER_TOKEN=
X_API_BASE_URL=https://api.x.com/2
# search (periodic recent search) | stream (filtered stream, 1 connection)
X_COLLECTION_MODE=search
X_POLL_SECONDS=300
X_MAX_RESULTS_PER_QUERY=25
# Hard daily cap on billable post reads (500 × $0.005 ≈ $2.50/day).
X_MAX_POST_READS_PER_DAY=500
# Pricing used for cost estimates — verify in the X Developer Console.
X_POST_READ_COST_USD=0.005
X_USER_READ_COST_USD=0.01
# Re-check stored posts for deletion every N hours (0 = off). Uses read budget.
X_COMPLIANCE_REFRESH_HOURS=24
X_CONTENT_RETENTION_DAYS=30

# --- AI analysis (optional, paid per token) -------------------------------
# Without a key, the deterministic rules-based pipeline runs alone.
ANTHROPIC_API_KEY=
AI_ENABLED=true
# claude-opus-5-5 ($4/$20 per M tokens) is the default. claude-haiku-5-5
# ($0.10/$0.50 per M tokens) is ~40× cheaper for this extraction task.
AI_MODEL=claude-opus-5-5
AI_EFFORT=low
AI_TIMEOUT_MS=30000
AI_MAX_RETRIES=2
# Server-side refusal fallback (supported Claude models only).
AI_SERVER_FALLBACK=true

# --- Cost & volume controls -----------------------------------------------
MAX_AI_ANALYSES_PER_DAY=100
MAX_AI_DAILY_COST_USD=1.00
# Only events with a preliminary importance ≥ this get AI analysis.
MIN_SCORE_FOR_AI=45
MAX_POSTS_PER_INTERVAL=50
MAX_SOURCE_QUERIES_PER_HOUR=12
MAX_QUEUE_DEPTH=2000
MAX_NOTIFICATIONS_PER_HOUR=20
ALERT_COOLDOWN_MINUTES=30
STALE_AFTER_HOURS=24

# --- Notification channels (owner only; optional) -------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=
