{
  "name": "signal-terminal",
  "version": "0.1.0",
  "private": true,
  "description": "Market-intelligence research terminal: collects authorized source data, detects and scores potentially market-moving events, and supports disciplined research.",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "node node_modules/next/dist/bin/next dev -H 127.0.0.1",
    "build": "node node_modules/next/dist/bin/next build",
    "start": "node node_modules/next/dist/bin/next start",
    "worker": "node node_modules/tsx/dist/cli.mjs src/server/worker/main.ts",
    "lint": "node node_modules/eslint/bin/eslint.js .",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit",
    "test": "node node_modules/vitest/vitest.mjs run",
    "test:watch": "node node_modules/vitest/vitest.mjs",
    "test:e2e": "node node_modules/@playwright/test/cli.js test",
    "db:generate": "node node_modules/drizzle-kit/bin.cjs generate",
    "db:migrate": "node node_modules/tsx/dist/cli.mjs scripts/migrate.ts",
    "db:seed": "node node_modules/tsx/dist/cli.mjs scripts/seed.ts",
    "check": "npm run typecheck && npm run lint && npm run test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.132.1",
    "@electric-sql/pglite": "^0.5.8",
    "@tanstack/react-query": "^5.104.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "fast-xml-parser": "^5.11.2",
    "lucide-react": "^1.53.0",
    "next": "16.4.0",
    "nodemailer": "^10.0.16",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.1",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.3"
  }
}
